# Copy this file to .env and fill in the runtime secret there.
# Windows PowerShell example: $env:SILICONFLOW_API_KEY="sk-xxxx"
#
# Precedence:
# 1. .env / environment variables provide runtime secrets and override selected defaults.
# 2. config.yaml provides non-sensitive defaults/documentation only.
# 3. app/config.py built-in defaults fill any remaining gaps.

SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL="Qwen/Qwen2.5-7B-Instruct"
SILICONFLOW_MAX_TOKENS="650"
SILICONFLOW_TIMEOUT_SECONDS="30"

# Optional: point to a different config file for non-sensitive defaults
# MSPC_CONFIG_PATH="config.yaml"
