# 复制本文件为 .env，然后填入你的硅基流动 API Key。
# Windows PowerShell 也可用：$env:SILICONFLOW_API_KEY="sk-xxxx"

SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL="Qwen/Qwen2.5-7B-Instruct"
SILICONFLOW_MAX_TOKENS="650"
SILICONFLOW_TIMEOUT_SECONDS="30"

# 可选：指定配置文件路径
# MSPC_CONFIG_PATH="config.yaml"
